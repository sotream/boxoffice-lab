{
  "name": "boxoffice-lab",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r --workspace-concurrency=1 --filter '!@boxoffice/e2e' test",
    "test:coverage": "pnpm -r --workspace-concurrency=1 --filter '!@boxoffice/e2e' exec vitest run --coverage",
    "test:mutation": "node scripts/mutation-check.mjs",
    "ops:check": "node ops/check.mjs",
    "mutation:validate": "node scripts/mutation-check.mjs --validate",
    "test:e2e": "pnpm --filter @boxoffice/e2e test",
    "test:e2e:faults": "pnpm --filter @boxoffice/e2e test:faults"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "fast-check": "^4.10.2",
    "yaml": "^2.9.1"
  }
}
